[Unit]
Description=BioNode V2.1 Soak-Test Logger
After=network.target

[Service]
Type=simple
User=aris
WorkingDirectory=/home/aris/bio_node_v2
ExecStartPre=/bin/sleep 20
ExecStart=/home/aris/bio_node_v2/.venv/bin/python /home/aris/bio_node_v2/logger.py
Restart=always
RestartSec=15
TimeoutStartSec=90
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
